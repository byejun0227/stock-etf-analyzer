# Streamlit Secrets 예시 파일
# Railway / Render / Streamlit Community Cloud 배포 시 환경변수 또는 Secrets UI에 추가하세요.
# 이 파일(.example)은 커밋 가능하지만, 실제 secrets.toml은 절대 커밋하지 마세요.

# ── FRED API (시장환경 분석) ───────────────────────────────────────────────
FRED_API_KEY = "여기에_발급받은_키_입력"
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html (무료)

# ── 관리자 계정 ────────────────────────────────────────────────────────────
ADMIN_ID = "admin"
ADMIN_PW = "안전한_비밀번호_입력"

# ── OAuth 공통 ─────────────────────────────────────────────────────────────
# 배포 후 실제 URL로 변경하세요 (로컬 테스트: http://localhost:8501)
REDIRECT_URI = "https://your-app.railway.app"

# ── Google OAuth ───────────────────────────────────────────────────────────
# 발급: https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# 승인된 리디렉션 URI에 REDIRECT_URI 값을 추가해야 합니다.
GOOGLE_CLIENT_ID     = "xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "GOCSPX-xxxxxxxxxxxxxxxx"

# ── Kakao OAuth ────────────────────────────────────────────────────────────
# 발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
# Kakao Developers → 앱 설정 → 플랫폼 → Web → 사이트 도메인에 REDIRECT_URI 추가
# Kakao Developers → 제품 설정 → 카카오 로그인 → Redirect URI에 REDIRECT_URI 추가
KAKAO_REST_API_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
