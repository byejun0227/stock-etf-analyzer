# Vercel 프로젝트 설정 → Environment Variables 에 등록하세요.
# 이 파일(.env.example)은 커밋 가능하지만, 실제 값이 들어간 .env.local은 절대 커밋하지 마세요.

# ── 세션 (필수 — 없으면 로그인 기능이 동작하지 않습니다) ──────────────────
# 임의의 긴 무작위 문자열 (예: openssl rand -base64 32)
SESSION_SECRET="여기에_임의의_긴_무작위_문자열_입력"

# ── FRED API (시장환경 분석) ───────────────────────────────────────────
FRED_API_KEY="여기에_발급받은_키_입력"
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html (무료)

# ── 관리자 계정 ────────────────────────────────────────────────────────
ADMIN_ID="admin"
ADMIN_PW="안전한_비밀번호_입력"

# ── OAuth 공통 ─────────────────────────────────────────────────────────
# 배포 도메인으로 설정하세요 (예: https://your-app.vercel.app). 로컬 테스트: http://localhost:3000
# 콜백 경로는 자동으로 `${REDIRECT_URI}/api/auth/callback` 이 됩니다.
REDIRECT_URI="https://your-app.vercel.app"

# ── Google OAuth ───────────────────────────────────────────────────────
# 발급: https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
# 승인된 리디렉션 URI에 `${REDIRECT_URI}/api/auth/callback` 값을 등록해야 합니다.
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxx"

# ── Kakao OAuth ────────────────────────────────────────────────────────
# 발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
# Kakao Developers → 앱 설정 → 플랫폼 → Web → 사이트 도메인에 REDIRECT_URI 추가
# Kakao Developers → 제품 설정 → 카카오 로그인 → Redirect URI에 `${REDIRECT_URI}/api/auth/callback` 추가
KAKAO_REST_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
