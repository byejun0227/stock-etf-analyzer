{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{__pycache__/**,*.pyc}"
    }
  },
  "rewrites": [
    { "source": "/api/analyze", "destination": "/api/index.py" },
    { "source": "/api/health", "destination": "/api/index.py" }
  ]
}
